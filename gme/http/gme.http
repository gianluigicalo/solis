### 
# 3. Richiesta Dati di Mercato (es. Prezzi MGP)
POST {{baseUrl}}/RequestData
# httpyac pesca in automatico il campo "token" dalla risposta "gmeAuth"
Authorization: Bearer {{gmeAuth.token}}
Content-Type: application/json

{
  "Platform": "PublicMarketResults",
  "Segment": "MGP",
  "DataName": "ME_ZonalPrices",
  "IntervalStart": 20261118,
  "IntervalEnd": 20261118,
  "Attributes": {}
}