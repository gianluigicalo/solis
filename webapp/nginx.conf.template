server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;

    # DNS interno di Docker: i servizi vengono risolti a ogni richiesta, così nginx parte anche se
    # un servizio non è ancora avviato
    resolver 127.0.0.11 valid=30s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;

    location /api/inverter/ {
        set $inverter ${INVERTER_URL};
        proxy_pass $inverter;
    }

    location /api/meteo/ {
        set $openmeteo ${OPENMETEO_URL};
        proxy_pass $openmeteo;
    }

    # regole, consigli, impostazioni e storico
    location ~ ^/api/(advice|rules|settings|history)(/|$) {
        set $advisor ${ADVISOR_URL};
        # l'import dello storico meteo può richiedere tempo
        proxy_read_timeout 600s;
        proxy_pass $advisor;
    }

    # file con hash nel nome: cache lunga
    location ~* \.(js|css|woff2?|ico|svg|png)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # applicazione a pagina singola: ogni altro percorso serve index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
